{
  "branches": [
    "main",
    { "name": "beta", "prerelease": true },
    { "name": "alpha", "prerelease": true }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "yq -i '.version = \"${nextRelease.version}\"' custom_components/climate_template/manifest.json && cd custom_components/climate_template && zip ../../climate_template.zip -r ./"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "climate_template.zip", "label": "climate_template.zip" }],
        "successComment": false,
        "failComment": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["custom_components/climate_template/manifest.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ]
  ]
}
